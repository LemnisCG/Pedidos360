# Copia este archivo como .env y completa una CUENTA REMITENTE real.
# El destinatario se obtiene automáticamente de la sesión Microsoft Entra del cliente.
#
# Ejemplo para Gmail: usa una contraseña de aplicación, NO tu contraseña normal.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta-remitente@gmail.com
MAIL_PASSWORD=tu-clave-o-contrasena-de-aplicacion
MAIL_FROM=tu-cuenta-remitente@gmail.com
