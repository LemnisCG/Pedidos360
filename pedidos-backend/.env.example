# Pedidos360 · entorno local
FRONTEND_URL=http://localhost:4200
FRONTEND_PUBLIC_URL=http://localhost:4200
GATEWAY_PUBLIC_URL=http://localhost:8080
JWT_SECRET=cambia-esta-clave-por-una-cadena-segura-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Microsoft Entra External ID · tenant pedidos360auth. El Client Secret es obligatorio para el callback Web del backend.
MICROSOFT_CLIENT_ID=6314fdda-9417-40f2-8ebe-9cc6ef7cd4ed
MICROSOFT_TENANT_ID=92aabe28-d724-4ac3-a20c-45088143bf29
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTH_URL=https://pedidos360auth.ciamlogin.com/92aabe28-d724-4ac3-a20c-45088143bf29/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://pedidos360auth.ciamlogin.com/92aabe28-d724-4ac3-a20c-45088143bf29/oauth2/v2.0/token
MICROSOFT_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
MICROSOFT_SCOPE=openid profile email offline_access

# Proveedores OAuth 2.0. No subas secretos reales a GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Facebook usa Authorization Code + PKCE. El backend persiste state/code_verifier en PostgreSQL.
# Si tu aplicación Meta antigua no admite PKCE, puedes cambiarlo temporalmente a false.
FACEBOOK_PKCE_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SMTP real. Para Gmail utiliza una contraseña de aplicación.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# PostgreSQL local de Docker.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
