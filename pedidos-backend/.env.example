# Pedidos360 · entorno local
FRONTEND_URL=http://localhost:4200
FRONTEND_PUBLIC_URL=http://localhost:4200

# Microsoft Entra External ID · tenant pedidos360auth.
# El api-gateway valida con estos datos el access token que MSAL obtiene en el frontend.
# Ninguno es secreto: la validación usa las claves públicas del tenant, no un Client Secret.
ENTRA_EXTERNAL_ID_ISSUER_URI=https://92aabe28-d724-4ac3-a20c-45088143bf29.ciamlogin.com/92aabe28-d724-4ac3-a20c-45088143bf29/v2.0
ENTRA_EXTERNAL_ID_API_AUDIENCE=6314fdda-9417-40f2-8ebe-9cc6ef7cd4ed
ENTRA_EXTERNAL_ID_REQUIRED_SCOPE=BFF.Access

# SMTP real. Para Gmail utiliza una contraseña de aplicación.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=  
MAIL_PASSWORD=
MAIL_FROM=

# Clúster de RabbitMQ: los dos nodos deben compartir esta cookie. Cámbiala en la nube.
RABBITMQ_ERLANG_COOKIE=pedidos360-cookie-del-cluster-rabbitmq

# PostgreSQL local de Docker.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
