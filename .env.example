# Pedidos360 · entorno local
FRONTEND_URL=
FRONTEND_PUBLIC_URL=

# Microsoft Entra External ID · tenant pedidos360auth.
# El api-gateway valida con estos datos el access token que MSAL obtiene en el frontend.
ENTRA_EXTERNAL_ID_ISSUER_URI=
ENTRA_EXTERNAL_ID_API_AUDIENCE=
ENTRA_EXTERNAL_ID_REQUIRED_SCOPE=

# SMTP real. Para Gmail utiliza una contraseña de aplicación.
MAIL_ENABLED=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# PostgreSQL local de Docker.
POSTGRES_USER=
POSTGRES_PASSWORD=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# RabbitMQ cluster
RABBITMQ_ERLANG_COOKIE=

